const STORAGE_KEY = 'shoppingList'
const THEME_KEY = 'shoppingList:theme'
const FILTER_KEY = 'shoppingList:filter'
const form = document.getElementById('item-form')
const input = document.getElementById('item-input')
const qtyInput = document.getElementById('item-qty')
const priceInput = document.getElementById('item-price')
const sectorInput = document.getElementById('item-sector')
const colorPicker = document.getElementById('color-picker')
const listEl = document.getElementById('items-list')
const totalSummary = document.getElementById('total-summary')
const clearBtn = document.getElementById('clear-btn')
const filterContainer = document.querySelector('.filters')
const voiceBtn = document.getElementById('voice-btn')
const voiceStatus = document.getElementById('voice-status')

const PLAYLIST_KEY = 'shoppingList:playlist'
const songForm = document.getElementById('song-form')
const songTitleInput = document.getElementById('song-title')
const songUrlInput = document.getElementById('song-url')
const playlistEl = document.getElementById('playlist')
const playAllBtn = document.getElementById('play-all-btn')

let currentFilter = localStorage.getItem(FILTER_KEY) || 'all'

function loadList(){
  const raw = localStorage.getItem(STORAGE_KEY)
  return raw ? JSON.parse(raw) : []
}

function saveList(list){
  localStorage.setItem(STORAGE_KEY, JSON.stringify(list))
}

function parsePriceValue(raw){
  if(!raw) return null
  const cleaned = raw.replace(/[^\d,\.] /g, '').replace(',', '.')
  const value = parseFloat(cleaned)
  return isNaN(value) ? null : value
}

function formatMoney(value){
  return value.toLocaleString('pt-BR', {style:'currency', currency:'BRL'})
}

function estimateUnitPrice(name){
  const lower = name.toLowerCase()
  const estimates = [
    {price: 6.50, keywords: ['arroz', 'feijão', 'macarrão', 'massa', 'farinha']},
    {price: 8.00, keywords: ['biscoito', 'bolacha', 'cookie', 'wafer', 'cracker']},
    {price: 4.50, keywords: ['batata frita', 'salgadinho', 'chocolate', 'bala', 'doces', 'bombom']},
    {price: 12.00, keywords: ['leite', 'iogurte', 'requeijão', 'umaça', 'queijo', 'presunto']},
    {price: 3.50, keywords: ['pão', 'bolo', 'croissant', 'torrada', 'pão de queijo']},
    {price: 2.50, keywords: ['alface', 'tomate', 'cenoura', 'batata', 'cebola', 'alho', 'pepino', 'banana', 'maçã']},
    {price: 5.00, keywords: ['refrigerante', 'suco', 'água', 'cerveja', 'chá']},
    {price: 14.00, keywords: ['frango', 'carne', 'peixe', 'linguiça', 'bife', 'picanha']},
    {price: 7.50, keywords: ['sabonete', 'shampoo', 'creme dental', 'desodorante', 'papel higiênico']},
    {price: 10.00, keywords: ['detergente', 'sabão', 'limpador', 'desinfetante', 'esponja']},
    {price: 9.00, keywords: ['granola', 'barrinha de cereal', 'aveia', 'castanha', 'sementes', 'chia', 'quinoa']}
  ]
  for(const estimate of estimates){
    if(estimate.keywords.some(keyword => lower.includes(keyword))) return estimate.price
  }
  return 5.00
}

function addItem(name, qty, sector, price){
  const autoSector = detectSector(name)
  const finalSector = sector && sector !== 'Geral' ? sector : autoSector
  const itemPrice = parsePriceValue(price)
  const list = loadList()
  list.push({name, qty, sector: finalSector, price: itemPrice})
  saveList(list)
  render()
}

function escapeHtml(s){
  return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":"&#39;"}[c]))
}

function render(){
  const list = loadList()
  listEl.innerHTML = ''
  // normalize items and keep original index
  const normalized = list.map((it, i) => {
    const unitPrice = (it.price != null) ? Number(it.price) : null
    const derivedPrice = unitPrice != null ? unitPrice : estimateUnitPrice(it.name || '')
    return {
      idx: i,
      name: it.name || '',
      qty: (it.qty && Number(it.qty)) || 1,
      sector: it.sector || 'Geral',
      price: unitPrice,
      displayPrice: derivedPrice,
      estimated: unitPrice == null,
      done: !!it.done
    }
  })
  // aplicar filtro antes de agrupar
  const filtered = normalized.filter(item => {
    if(currentFilter === 'pendentes') return !item.done
    if(currentFilter === 'comprados') return item.done
    return true
  })

  // group by sector
  const groups = filtered.reduce((acc, item) => {
    const key = item.sector || 'Geral'
    if(!acc[key]) acc[key] = []
    acc[key].push(item)
    return acc
  }, {})
  // sectors sorted alphabetically
  let totalCost = 0
  const sectors = Object.keys(groups).sort((a,b)=> a.localeCompare(b, 'pt', {sensitivity:'base'}))
  sectors.forEach(sector => {
    const group = groups[sector]
    group.sort((a,b)=> a.name.localeCompare(b.name, 'pt', {sensitivity:'base'}))
    const wrapper = document.createElement('div')
    wrapper.className = 'sector-group'
    const title = document.createElement('div')
    title.className = 'sector-title'
    title.textContent = sector
    const ul = document.createElement('ul')
    group.forEach(item => {
      const li = document.createElement('li')
      li.className = 'item' + (item.done ? ' done' : '')
      const priceLabel = item.displayPrice != null ? formatMoney(item.displayPrice) : 'R$ 0,00'
      const estimateLabel = item.estimated ? ' (estimado)' : ''
      li.innerHTML = `<label><input type="checkbox" data-index="${item.idx}" ${item.done? 'checked':''}> <span class="text">${escapeHtml(item.name)} <small class="qty">x${item.qty}</small></span></label><span class="item-price">${priceLabel}${estimateLabel} cada</span><div class="actions"><button data-edit-price="${item.idx}">Valor</button><button data-edit-qty="${item.idx}">Quantidade</button><button data-delete="${item.idx}">Excluir</button></div>`
      totalCost += item.displayPrice * item.qty
      ul.appendChild(li)
    })
    wrapper.appendChild(title)
    wrapper.appendChild(ul)
    listEl.appendChild(wrapper)
  })
  if(totalSummary){
    totalSummary.textContent = `Total estimado: ${formatMoney(totalCost)}`
  }
}

function applySavedTheme(){
  const saved = localStorage.getItem(THEME_KEY)
  const color = saved || getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || '#2b7cff'
  document.documentElement.style.setProperty('--accent', color)
  if(colorPicker) colorPicker.value = color
}

if(colorPicker){
  colorPicker.addEventListener('input', (e)=>{
    const c = e.target.value
    document.documentElement.style.setProperty('--accent', c)
    localStorage.setItem(THEME_KEY, c)
  })
}

function updateFilterUI(){
  if(!filterContainer) return
  const buttons = filterContainer.querySelectorAll('[data-filter]')
  buttons.forEach(b=> b.classList.toggle('active', b.getAttribute('data-filter') === currentFilter))
}

if(filterContainer){
  filterContainer.addEventListener('click', (e)=>{
    const btn = e.target.closest('[data-filter]')
    if(!btn) return
    currentFilter = btn.getAttribute('data-filter')
    localStorage.setItem(FILTER_KEY, currentFilter)
    updateFilterUI()
    render()
  })
}

form.addEventListener('submit', (e)=>{
  e.preventDefault()
  const name = input.value.trim()
  if(!name) return
  const qty = parseInt(qtyInput.value, 10) || 1
  const price = priceInput ? priceInput.value.trim() : ''
  const sector = (sectorInput && sectorInput.value) || 'Geral'
  addItem(name, qty, sector, price)
  input.value = ''
  qtyInput.value = 1
  if(priceInput) priceInput.value = ''
  if(sectorInput) sectorInput.value = 'Geral'
})

function normalizeSector(raw){
  const sectors = ['Geral','Frios','Carnes','Hortifruti','Padaria','Bebidas','Limpeza','Música','Mercearia','Higiene','Bobagem','Biscoito','Alimentos Saudável','Outros']
  if(!raw) return 'Geral'
  const normalized = raw.trim().toLowerCase()
  const found = sectors.find(s => normalized === s.toLowerCase() || normalized.includes(s.toLowerCase()))
  return found || 'Geral'
}

function detectSector(name){
  const lower = name.toLowerCase()
  const keywordsMatch = (text, keyword) => {
    const escaped = keyword.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
    const regex = new RegExp(`\\b${escaped}\\b`, 'i')
    return regex.test(text)
  }
  const categories = [
    {sector:'Bobagem', keywords:['chocolate','bala','salgadinho','doces','bombom','pipoca salgada']},
    {sector:'Mercearia', keywords:['arroz','feijão','macarrão','massa','farinha','açúcar','sal','óleo','azeite','tempero','café','milho','pipoca']},
    {sector:'Higiene', keywords:['sabonete','shampoo','condicionador','creme dental','desodorante','papel higiênico','absorvente','escova','fio dental','lenços','sabonete líquido']},
    {sector:'Açougue', keywords:['carne','frango','peixe','linguiça','bife','patinho','alcatra','picanha','costela','hambúrguer']},
    {sector:'Bebidas', keywords:['refrigerante','suco','água','cerveja','vinho','cachaça','vodca','whisky','energético','cola','chá gelado']},
    {sector:'Hortifruti', keywords:['alface','tomate','cenoura','batata','cebola','alho','pepino','abacate','banana','maçã','laranja','uva','verdura','legume','hortaliça']},
    {sector:'Padaria', keywords:['pão','bolo','croissant','rosca','torrada','pão de queijo','pãozinho','cookies','sanduíche']},
    {sector:'Frios', keywords:['queijo','presunto','mussarela','mortadela','manteiga','iogurte','requeijão','nata']},
    {sector:'Limpeza', keywords:['detergente','sabão','esponja','alvejante','desinfetante','limpador','saco de lixo','pano','vassoura','desodorante de ambiente']},
    {sector:'Biscoito', keywords:['biscoito','wafer','bolacha','cracker','cookie','cream cracker']},
    {sector:'Alimentos Saudável', keywords:['barrinha de cereal','granola','aveia','mix de castanhas','castanha','sementes','chia','quinoa','linhaça','cereal']}
  ]
  for(const category of categories){
    if(category.keywords.some(keyword => keywordsMatch(lower, keyword))) return category.sector
  }
  return 'Geral'
}

function parseVoiceCommand(text){
  const cleaned = text.toLowerCase().replace(/[.,!?]/g,'').trim()
  let phrase = cleaned.replace(/^(adicionar|colocar|botar|bota|quero|preciso de|gostaria de|por favor|adiciona?)(?:\s+de)?\s+/, '').trim()
  let qty = 1
  let sector = 'Geral'
  let price = null
  let name = phrase

  const qtyMatch = phrase.match(/^(\d+)\s+(.*)$/)
  if(qtyMatch){
    qty = Number(qtyMatch[1]) || 1
    phrase = qtyMatch[2].trim()
  }

  const priceMatch = phrase.match(/\b(?:por|de)\s+(\d+[\.,]?\d{0,2})\s*(?:reais?|rs|r\$)?$/)
  if(priceMatch){
    const parsedPrice = parsePriceValue(priceMatch[1])
    if(parsedPrice != null){
      phrase = phrase.slice(0, priceMatch.index).trim()
      price = parsedPrice
    }
  }

  const sectorMatch = phrase.match(/(.+?)\s+(?:no|na|no setor|na seção|setor|seção|categoria|no mercado)\s+(.+)$/)
  if(sectorMatch){
    name = sectorMatch[1].trim()
    sector = normalizeSector(sectorMatch[2])
  }

  name = name.replace(/\b(de|do|da|dos|das)\b/g,'').trim()
  if(!name) return null

  return {name, qty: qty || 1, sector, price}
}

function setVoiceStatus(text){
  if(voiceStatus) voiceStatus.textContent = text
}

function startVoiceRecognition(){
  const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition
  if(!SpeechRecognition){
    alert('Seu navegador não suporta reconhecimento de voz.')
    return
  }

  const recognition = new SpeechRecognition()
  recognition.lang = 'pt-BR'
  recognition.interimResults = false
  recognition.maxAlternatives = 1

  setVoiceStatus('Escutando...')
  recognition.start()

  recognition.onresult = (event) => {
    const transcript = event.results[0][0].transcript
    const command = parseVoiceCommand(transcript)
    if(command){
      addItem(command.name, command.qty, command.sector, command.price)
      setVoiceStatus(`Adicionado: ${command.qty} x ${command.name} (${command.sector})`)
    } else {
      setVoiceStatus(`Não entendi: "${transcript}"`)
    }
  }

  recognition.onerror = (event) => {
    setVoiceStatus(`Erro: ${event.error}`)
  }

  recognition.onend = () => {
    if(voiceStatus && voiceStatus.textContent === 'Escutando...'){
      setVoiceStatus('Pronto para comando de voz.')
    }
  }
}

if(voiceBtn){
  voiceBtn.addEventListener('click', startVoiceRecognition)
}

listEl.addEventListener('click', (e)=>{
  const editPrice = e.target.closest('[data-edit-price]')
  const editQty = e.target.closest('[data-edit-qty]')
  const del = e.target.closest('[data-delete]')
  if(editPrice){
    const idx = Number(editPrice.getAttribute('data-edit-price'))
    const list = loadList()
    const current = list[idx]
    const updatedPrice = prompt('Preço (R$)', current.price != null ? current.price : '')
    if(updatedPrice === null) return
    const priceVal = parsePriceValue(updatedPrice.trim())
    list[idx].price = priceVal
    saveList(list)
    render()
    return
  }
  if(editQty){
    const idx = Number(editQty.getAttribute('data-edit-qty'))
    const list = loadList()
    const current = list[idx]
    const updatedQty = prompt('Quantidade', String(current.qty))
    if(updatedQty === null) return
    const q = parseInt(updatedQty, 10)
    list[idx].qty = (isNaN(q) || q < 1) ? 1 : q
    saveList(list)
    render()
    return
  }
  if(del){
    const idx = Number(del.getAttribute('data-delete'))
    const list = loadList()
    list.splice(idx,1)
    saveList(list)
    render()
    return
  }
})

listEl.addEventListener('change', (e)=>{
  if(e.target.type === 'checkbox'){
    const idx = Number(e.target.getAttribute('data-index'))
    const list = loadList()
    list[idx].done = e.target.checked
    saveList(list)
    render()
  }
})

clearBtn.addEventListener('click', ()=>{
  if(confirm('Apagar todos os itens?')){
    localStorage.removeItem(STORAGE_KEY)
    render()
  }
})



render()
// Definir tema rosa conforme solicitado e salvar no localStorage
localStorage.setItem(THEME_KEY, '#ff69b4')
applySavedTheme()
updateFilterUI()
