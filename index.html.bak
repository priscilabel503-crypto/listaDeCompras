s<!doctype html>
<html lang="pt-br">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Lista de Compras</title>
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <div class="container">
    <h1>Lista de Compras da Bel</h1>
    <p class="intro">Olá — bem-vinda à lista de compras da Priscila. Aproveite muito!</p>
    <form id="item-form">
      <input id="item-input" placeholder="Adicione um item" autocomplete="off" required>
      <input id="item-qty" type="number" min="1" value="1" aria-label="Quantidade" required>
      <input id="item-price" type="text" placeholder="Preço opcional" aria-label="Preço">
      <select id="item-sector" aria-label="Setor">
        <option value="Geral">Geral</option>
        <option value="Mercearia">Mercearia</option>
        <option value="pecuaria">Pecuária</option>
        <option value="Higiene">Higiene</option>
        <option value="Açougue">Açougue</option>
        <option value="Hortifruti">Hortifruti</option>
        <option value="Padaria">Padaria</option>
        <option value="Bebidas">Bebidas</option>
        <option value="Limpeza">Limpeza</option>
        <option value="biscoito">Biscoito</option>
        <option value="Alimentos Saudável">Alimentos Saudável</option>
        <option value="Outros">Outros</option>
      </select>
      <button id="add-btn" type="submit">Adicionar</button>
      <button id="voice-btn" type="button">🎤 Falar</button>
    </form>
    <div id="voice-status" class="voice-status"></div>
    <div id="total-summary" class="total-summary"></div>
    <div class="filters">
      <button data-filter="all" class="filter-btn active">Todos</button>
      <button data-filter="pendentes" class="filter-btn">Pendentes</button>
      <button data-filter="comprados" class="filter-btn">Comprados</button>
    </div>
    <ul id="items-list"></ul>
    <div class="controls">
      <label class="color-label">Tema: <input id="color-picker" type="color" title="Escolher cor"></label>
      <button id="clear-btn">Limpar tudo</button>
    </div>
    <div class="playlist">
      <h2>Playlist</h2>
      <button id="play-all-btn" class="play-all">Abrir todas</button>
      <form id="song-form">
        <input id="song-title" placeholder="Título da música" required>
        <input id="song-url" placeholder="URL opcional, Spotify/YouTube, outro link ou termo de busca">
        <button type="submit">Adicionar música</button>
      </form>
      <ul id="playlist"></ul>
    </div>
  </div>
  <script src="app.js" defer></script>
</body>
</html>
